{
  "name": "sales-agent-api",
  "private": true,
  "version": "1.0.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch watch.ts",
    "build": "tsc",
    "start": "node --import tsx watch.ts",
    "lint": "tsc --noEmit",
    "test": "jest --config test/jest.config.cjs",
    "schema:apply": "tsx src/scripts/applySchema.ts",
    "migrate": "node --import tsx node_modules/node-pg-migrate/bin/node-pg-migrate -c database/config/migrate-config.cjs -m database/migrations --ignore-pattern \"README.md\" up",
    "seed:admin": "tsx src/scripts/seedAdmin.ts",
    "db:init": "tsx src/scripts/applySchema.ts && npm run migrate && npm run seed:admin"
  },
  "dependencies": {
    "@fastify/compress": "^7.0.3",
    "@fastify/cors": "^8.5.0",
    "@fastify/helmet": "^11.1.1",
    "@fastify/jwt": "^8.0.1",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/websocket": "^10.0.1",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.7",
    "fastify": "^4.29.0",
    "ioredis": "^5.4.2",
    "node-pg-migrate": "^7.9.1",
    "pg": "^8.13.1",
    "postgres": "^3.4.5",
    "tsx": "^4.19.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.2"
  }
}
