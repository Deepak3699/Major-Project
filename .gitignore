# Tool/editor run artifacts -- these were committed before and bloated the repo.
# Browser automation dumps (MCP + playwright) and test runner output.
.playwright-mcp/
.playwright/
test-results/
playwright-report/

# Local runtime state written by the scraper fleet; not config, do not commit.
packages/scrapers/source_health.json

# Isolated local PostgreSQL data and manual startup diagnostics.
.local-runtime/

# Screenshots are documentation assets; drop them in docs/ explicitly with
# `git add -f` if a README really needs one.
/*.png

# Local presentation build outputs and temporary artifact previews.
/.presentation-build/
/.chart-data-*/
/output/imagegen/
