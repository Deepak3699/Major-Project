# Copy to the repository root as .env on the deployment VM.
# Generate secrets with: openssl rand -hex 32
# NEVER commit the filled-in .env.

# Public HTTPS hostname (DuckDNS subdomain pointing at the VM's public IP).
DOMAIN=your-name.duckdns.org

# Internal database password. Use a long random string.
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# Auth + at-rest encryption. Both must be long random strings.
JWT_SECRET=change-me-to-a-long-random-string
ENCRYPTION_SECRET=change-me-to-another-long-random-string-min-32-chars

# First administrator. Created by the setup script after the API is healthy.
BOOTSTRAP_ADMIN_EMAIL=you@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-to-a-strong-password

# Optional. Gemini is optional: every feature has a template fallback.
GEMINI_API_KEY=

# Optional provider keys (encrypted at rest when set in the admin UI).
SNOVIO_API_KEY=
CONTACT_OUT_API_KEY=
RESEND_API_KEY=
BREVO_API_KEY=

# Optional outreach/scraping limits.
SCRAPE_PERMITTED_SOURCES=
ENABLE_DAILY_SCHEDULER=0
DAILY_SCRAPE_CATCHUP=0
SCRAPER_MAX_CONCURRENCY=3

# Optional workflow automation credentials (only if you enable the n8n profile).
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change-me-too
